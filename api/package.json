{
  "name": "@vocali/api",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "serverless deploy",
    "dev": "docker compose -f ../compose.yaml up -d dynamodb && serverless offline start",
    "check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.883.0",
    "@aws-sdk/client-dynamodb": "^3.883.0",
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/lib-dynamodb": "^3.883.0",
    "@aws-sdk/s3-presigned-post": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@vocali/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "serverless": "^4.41.0",
    "serverless-offline": "^14.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
